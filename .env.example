# Ripples in the Pond — 环境变量示例
# 用法：复制本文件为 .env.local，把每一项填上真实值
# 注意：.env.local 不会入 git（私钥/secret 千万别 commit）
# 前缀 NEXT_PUBLIC_ 的变量会暴露给浏览器，没前缀的只在后端能读到

# ─────────────────────────────────────────────────
# Privy（登录服务）
# 注册：https://dashboard.privy.io/  → Create new app → 复制 App ID 和 App Secret
# ─────────────────────────────────────────────────
# Privy App ID（前端登录用，可以暴露）
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy App Secret（后端验证 JWT 用，绝不能暴露）
PRIVY_APP_SECRET=

# ─────────────────────────────────────────────────
# 链 & RPC（OP Sepolia 测试网 / OP Mainnet 生产）
# 项目主链是 Optimism (L2)，不是 Ethereum L1。详见 ARCHITECTURE.md 决策 3
# ─────────────────────────────────────────────────
# 链 ID：11155420 = OP Sepolia 测试网（生产时改为 10 = OP Mainnet）
NEXT_PUBLIC_CHAIN_ID=11155420

# Alchemy RPC（OP Sepolia）
# 注册：https://dashboard.alchemy.com/  → Create App → Network 选 "Optimism Sepolia" → 复制 HTTPS URL
# 前端用（只读，可以暴露 key）
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# 后端用（同一个 URL 也可以；建议另开一个独立 key 方便审计）
ALCHEMY_RPC_URL=

# ─────────────────────────────────────────────────
# 运营钱包（OPERATOR）— 后端代付 gas 用
# 重要：用一个全新的测试钱包，永远别放主钱包私钥
# 去 https://app.optimism.io/faucet 给这个地址领 ≥ 0.02 OP-ETH
# 备用 faucet：https://www.alchemy.com/faucets/optimism-sepolia
# ─────────────────────────────────────────────────
# 私钥（0x 开头的 64 位十六进制），绝不能暴露，绝不能 commit
OPERATOR_PRIVATE_KEY=

# ─────────────────────────────────────────────────
# Supabase（数据库）
# 注册：https://supabase.com/dashboard  → New project → 复制 URL 和 keys
# Settings → API 里能看到下面三个值
# ─────────────────────────────────────────────────
# 项目 URL（前端也用，可以暴露）
NEXT_PUBLIC_SUPABASE_URL=

# anon key（前端用）；全库已开 RLS 且不加 policy（migration phase-10/040）→ anon 读写归零
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key（后端用，绕过 RLS，绝不能暴露给前端）
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────
# 自签 JWT（Phase 4 — RS256 密钥对，后端签发 / 校验站内会话）
# 生成：openssl genrsa -out jwt-priv.pem 2048 && openssl rsa -in jwt-priv.pem -pubout -out jwt-pub.pem
# 填入时把 PEM 换行写成 \n（代码里会还原），或直接多行粘贴（视部署平台）
# ─────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─────────────────────────────────────────────────
# Upstash Redis（Phase 5 限流 + Phase 6 运营钱包全局锁）
# 注册：https://console.upstash.com/  → Create Database → REST API 里复制 URL / TOKEN
# ⚠ 缺失会让限流静默 fail-open（send-code 例外为 fail-closed）；主网前必配
# ─────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────
# 站点公开 URL（分享链接 / 海报短链 / 二维码用；cron 也读它）
# 生产：https://pond-ripple.xyz；本地留空则代码回退到 window.location.origin
# ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ─────────────────────────────────────────────────
# Cron 触发密钥
# 自己随便起一个长字符串（建议 32 位以上随机字符），用于校验 cron 端点合法调用
# 生成示例：openssl rand -hex 32
# ─────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────
# AirdropNFT 硬开关（Phase 6 P0-3，2026-05-08 strict CTO review）
# 设为 'true' 才允许 /api/cron/process-airdrop 实际执行；其他值（含未设）→ 直接返 disabled
# 测试网：设 'true' 保持现有空投行为
# 主网：**绝对不要设此 env**（D1 决策"主网不做空投"的代码层硬保护）
# ─────────────────────────────────────────────────
AIRDROP_ENABLED=

# ─────────────────────────────────────────────────
# Admin 观测性 token（Phase 3 S5.c / Phase 6 D2 + P1-10 改 Bearer-only）
# 调用：curl -H 'Authorization: Bearer <ADMIN_TOKEN>' https://.../api/cron/queue-status
#       或同款 Bearer 调用 /api/airdrop/trigger
# 用途：给 cron 操作者查 score_nft_queue 状态机卡住的任务 / 触发空投
# 生成：openssl rand -hex 32（和 CRON_SECRET 格式一样，但值不同）
# 旧 ?token=xxx query 已禁用（query 进浏览器历史风险大，2026-05-08 strict CTO review P1-10）
# ─────────────────────────────────────────────────
ADMIN_TOKEN=

# ─────────────────────────────────────────────────
# Arweave / Turbo（Phase 3 S0 — 底曲 / 音效 / decoder / metadata 永久存储）
# 付费方式：Turbo SDK + Base 链 ETH，用 topUpWithTokens() 链上交易换 credits
# 流程：
#   1. npx tsx scripts/arweave/generate-eth-wallet.ts  → 生成专用 ETH 钱包
#   2. MetaMask 在 Base 链转 ETH 到生成的地址
#   3. npx tsx scripts/arweave/wait-for-base-eth.ts    → 等到账
#   4. npx tsx scripts/arweave/topup-turbo.ts          → 换 credits
# ─────────────────────────────────────────────────
# 钱包 JSON 文件的绝对路径（含 privateKey + address + token 字段）
# 安全：文件路径必须在项目目录外。例：C:\Users\Hui\.ripples-secrets\turbo-wallet.json
TURBO_WALLET_PATH=

# 备选：直接内联 JWK JSON（无法用文件路径的部署平台用；与 TURBO_WALLET_PATH 二选一）
TURBO_WALLET_JWK=

# Base 链 RPC URL（可选）。留空用公开 RPC https://mainnet.base.org
# 生产或频繁调用建议用 Alchemy/Infura 的 Base 端点避免限流
BASE_RPC_URL=

# ─────────────────────────────────────────────────
# Phase 3 S2 合约地址 — ScoreNFT (ERC-721)
# 部署方式：forge script contracts/script/DeployScore.s.sol
# 前缀 NEXT_PUBLIC_ 是因为前端未来需要展示合约地址和 OpenSea 链接
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SCORE_NFT_ADDRESS=

# ─────────────────────────────────────────────────
# Phase 3 S3 合约地址 — MintOrchestrator
# ScoreNFT 的"前台"薄壳，S5 cron 走这个合约 mint
# 部署方式：SCORE_NFT_ADDRESS=0x... forge script DeployOrchestrator.s.sol
# ─────────────────────────────────────────────────
NEXT_PUBLIC_ORCHESTRATOR_ADDRESS=

# AirdropNFT 合约地址（Phase 4 S6；测试网空投用，主网不部署）
NEXT_PUBLIC_AIRDROP_NFT_ADDRESS=

# ─────────────────────────────────────────────────
# Phase 3 S4 — Score Decoder（"网页唱片机"）
# 自包含的 HTML 播放器，上传一次到 Arweave 后所有 ScoreNFT 共用
# 部署方式：npx tsx scripts/arweave/upload-decoder.ts
# 用途：S5 cron 生成 metadata 时把 animation_url 设成
#       https://arweave.net/<这里的 txid>?events=ar://...&base=ar://...&sounds=ar://...
# ─────────────────────────────────────────────────
SCORE_DECODER_AR_TX_ID=

# 音效映射表 Arweave txid（26 键 → 音效元数据；decoder 播放时拉取）
# 部署方式：npx tsx scripts/arweave/upload-sounds-map.ts
SOUNDS_MAP_AR_TX_ID=

# ─────────────────────────────────────────────────
# Semi 社区钱包（Phase 7 B1，PoC-only）
# 后端登录端点用它转发短信验证码 / 登录 / 查询 Semi 用户
# ─────────────────────────────────────────────────
SEMI_API_URL=https://semi-production.fly.dev

# ─────────────────────────────────────────────────
# Resend 告警（Phase 7 A8 — manual_review 邮件提醒）
# 未配置时只写日志，不影响 cron 主流程
# ─────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_TO_EMAIL=
ALERT_FROM_EMAIL=

# ─────────────────────────────────────────────────
# Vercel env 同步脚本（Phase 7 A9）
# 用途：npm run env-sync 对比 .env.local 与 Vercel env，主网前必跑
# VERCEL_TOKEN：在 vercel.com/account/tokens 生成（Read Only 即可）
# VERCEL_PROJECT_ID：在 Vercel 项目 Settings → General → Project ID
# ─────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────────
# Phase 6 C2 部署权限三件套 — 主网冷钱包 admin / 热钱包 minter 分离
# 详细 runbook：docs/MAINNET-RUNBOOK.md
# ─────────────────────────────────────────────────

# 部署钱包私钥（签 forge script 的 broadcast）
# 测试网：可直接复用 OPERATOR_PRIVATE_KEY 的值
# 主网：建议用一个一次性部署钱包，部署完即抛
DEPLOYER_PRIVATE_KEY=

# DEFAULT_ADMIN_ROLE 最终持有者（B-0 #8：独立普通钱包，≠ 铸造热钱包；私钥留本地不进这里）
# 主网强校验：admin ≠ minter ≠ deployer 且非零（DeployBase._assertMainnetRoles，踩线即 revert）
# 留空 = 测试网模式：回退到 deployer 地址（脚本 vm.envOr）
ADMIN_ADDRESS=

# MINTER_ROLE 最终持有者（运营热钱包，cron 用其签名 mint）
# 留空 = 测试网模式：回退到 deployer 地址
# 测试网通常 = OPERATOR 地址；主网 = 运营热钱包（须 == OPERATOR_PRIVATE_KEY 派生地址）
MINTER_ADDRESS=

# CT-1：ScoreNFT 永久 name/symbol（主网 chainid 10 缺这两个 → DeployScore 直接 revert，防焊错名）
# 主网正式值（B-0 #7）：名 "Ripples in the Pond" / 符号 "RPIP"；测试网留空回退带 (Testnet) 的名
SCORE_NFT_NAME=
SCORE_NFT_SYMBOL=

# CT-15：MaterialNFT 初始 URI（留空用脚本默认占位；部署后 admin setURI 到最终 Arweave 再 freezeURI）
MATERIAL_URI=
